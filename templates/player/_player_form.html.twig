<div class="overlay" id="add_update">
    <div id="player-form">
        <div id="player-form-header">
            <span id="close-player-form" onclick="closeFormModal('add_update')">X</span>
        </div>
        <form action="{{ path("app_add_update_player") }}" method="POST">
            <input type="hidden" id="type" name="add" value="add" />
            <input type="hidden" id="id" name="id" value="" />
            <label for="lastname">Nom : </label>
            <input type="text" id="lastname" name="lastname" />
            <label for="firstname">Prénom : </label>
            <input type="text" id="firstname" name="firstname" />
            <label for="poste">Poste : </label>
            <input type="text" id="poste" name="poste" />
            <label for="number">Numéro : </label>
            <input type="number" id="number" name="number" />

            <input id="submit" type="submit" value="Créer" />
        </form>
    </div>
</div>